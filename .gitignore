# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/playwright-report-pwa/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# Serwist generated files
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase local metadata
supabase/.temp/

# Codex local files
.codex/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
